# ============================================================
# DocAuth India — Mobile Environment Configuration Example
# ============================================================
# Copy this file to .env.local and fill in your actual values
# before running the mobile build.
#
# IMPORTANT: Never commit a file with real secrets to git!
# ============================================================

# Clerk Authentication Publishable Key
# Get from: https://dashboard.clerk.com → Your App → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY

# Backend API Base URL
# For LOCAL development on device (replace with your computer's LAN IP):
#   VITE_API_BASE_URL=http://192.168.1.100:5000/api
# For PRODUCTION deployment (your deployed server URL):
#   VITE_API_BASE_URL=https://your-backend.railway.app/api
# For WEB (browser, no change needed — uses Vite proxy):
#   Leave blank or comment out to default to /api proxy
VITE_API_BASE_URL=http://192.168.1.100:5000/api
