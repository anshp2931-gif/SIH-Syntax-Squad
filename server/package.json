{
  "name": "document-verifier-server",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "nodemonConfig": {
    "watch": [
      "."
    ],
    "ext": "js,json",
    "ignore": [
      "uploads/*",
      "samples/*",
      "node_modules/*"
    ]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "mongoose": "^8.5.1",
    "multer": "^1.4.5-lts.1",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "tesseract.js": "^5.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
